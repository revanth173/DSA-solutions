class Solution {
    public int maxProfit(int[] prices) {
        int n = prices.length;
        int[] arr = new int[n-1];
        int j = 0;
        for(int i = 1;i<n;i++)
        {
            arr[j] = prices[i]-prices[i-1];
            j++;
        }
        int count= 0;
        for(int i = 0;i<arr.length;i++)
        {
            if(arr[i]>=0)
            {
                count+=arr[i];
            }
        }
        return count;
    }
}
