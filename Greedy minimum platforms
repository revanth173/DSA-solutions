class Solution {
    public int minPlatform(int arr[], int dep[]) {
            Arrays.sort(arr);
            Arrays.sort(dep);
            int max = 0;
            int stations = 0;
            int i = 0;
            int j = 0;
            int n = arr.length;
            while(i<n&& j<n)
            {
                if(arr[i]<=dep[j])
                {
                    i++;
                    stations++;
                }
                else
                {
                    j++;
                    stations--;
                }
                max = Math.max(max,stations);
            }
            return max;
        
    }
}
